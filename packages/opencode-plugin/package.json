{
  "name": "@opencode-panes/plugin",
  "version": "0.4.0",
  "description": "Upload ordinary browser-ready files to a private Panes artifact library",
  "private": true,
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "artifacts",
    "artifact-viewer",
    "developer-tools"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/global.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/global.js",
      "default": "./dist/global.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.12.0",
    "opencode": ">=2.0.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@opencode-panes/contracts": "0.4.0",
    "@opencode/plugin": "^2.0.18",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "zod": "^4.4.3"
  }
}
