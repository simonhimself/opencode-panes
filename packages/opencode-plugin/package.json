{
  "name": "@opencode-panes/plugin",
  "version": "0.0.0",
  "description": "OpenCode server plugin for creating and revising OpenCode Panes artifacts",
  "private": true,
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "artifacts",
    "artifact-viewer",
    "developer-tools"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "commands",
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.12.0",
    "opencode": ">=1.18.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.18"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.18",
    "@opencode-panes/contracts": "0.0.0",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9"
  }
}
