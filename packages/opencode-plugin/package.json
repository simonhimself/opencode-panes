{
  "name": "@opencode-panes/plugin",
  "version": "0.2.0",
  "description": "OpenCode server plugin for creating and revising OpenCode Panes artifacts",
  "private": true,
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "artifacts",
    "artifact-viewer",
    "developer-tools"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "commands",
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dependencies": {
    "@opencode-panes/renderers": "*",
    "dompurify": "^3.4.13",
    "ignore": "^7.0.6",
    "linkedom": "^0.18.12",
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "engines": {
    "node": ">=22.12.0",
    "opencode": ">=1.18.18"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.18"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.18",
    "@opencode-panes/contracts": "0.2.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.25.9",
    "esbuild-wasm": "^0.28.2",
    "jsdom": "^29.1.1"
  }
}
