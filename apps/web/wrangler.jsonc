{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "opencode-panes",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // These are production policy values, not credential material.
    // Access must protect /inventory* and /api/library*; the Worker also
    // verifies every owner request. Keep public and upload routes outside Access.
    "PANES_ACCESS_ALLOWED_EMAIL": "simonhimself@gmail.com",
    "PANES_ACCESS_ISSUER": "https://adsdasd.cloudflareaccess.com",
    "PANES_ACCESS_AUDIENCE": "8defff93e1db0b5ea650b2d7e75f67b6d22a3597a67bada071458ebe8dc48725",
    "PANES_DEV_MODE": "false",
  },
  // Production admission control. Upload the value as an encrypted Worker secret.
  "secrets": {
    "required": ["PANES_UPLOAD_KEY"],
  },
  "observability": {
    // Invocation logs and traces include URLs containing read capabilities.
    "enabled": false,
  },
  "triggers": {
    // Retry private object cleanup for deleted artifact tombstones.
    "crons": ["17 * * * *"],
  },
  "assets": {
    // The Vite build supplies the assets directory in its generated config.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/api/*", "/inventory", "/inventory/*", "/s/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opencode-panes",
      "database_id": "52f1b05b-0aa6-421d-ab8f-30cc914c3d9b",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PRIVATE_ARTIFACTS",
      "bucket_name": "opencode-panes-private",
    },
  ],
}
