{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "opencode-panes",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // This is an admission policy value, not credential material. The Access
    // issuer and application audience are deployment inputs and are omitted
    // here deliberately, so dry runs cannot publish fake production values.
    "PANES_ACCESS_ALLOWED_EMAIL": "simonhimself@gmail.com",
  },
  // Deferred to Ticket 23's approved deployment:
  // PANES_ACCESS_ISSUER = the exact HTTPS team domain, for example
  // https://<team-name>.cloudflareaccess.com
  // PANES_ACCESS_AUDIENCE = the Access application's AUD tag.
  // Create one self-hosted Access application with paths /inventory and
  // /api/inventory* only. Its sole Allow policy includes the exact email above.
  // Do not protect creator, public, legacy, or capability routes.
  // Production admission control. Upload the value as an encrypted Worker secret.
  "secrets": {
    // Versioned AES-GCM key material. Set with `wrangler secret put`; never
    // place a value in this file or in source control.
    "required": ["PANES_CREATE_API_KEY", "PUBLICATION_ENCRYPTION_KEY_V1"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "triggers": {
    "crons": ["17 * * * *"],
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opencode-panes",
      "database_id": "52f1b05b-0aa6-421d-ab8f-30cc914c3d9b",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PRIVATE_ARTIFACTS",
      "bucket_name": "opencode-panes-private",
    },
  ],
}
