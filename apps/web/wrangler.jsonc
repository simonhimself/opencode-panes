{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "opencode-panes",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  // Production admission control. Upload the value as an encrypted Worker secret.
  "secrets": {
    "required": ["PANES_CREATE_API_KEY"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "opencode-panes",
      "database_id": "52f1b05b-0aa6-421d-ab8f-30cc914c3d9b",
      "migrations_dir": "./migrations",
    },
  ],
}
